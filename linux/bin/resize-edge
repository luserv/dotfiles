#!/bin/bash
# resize-edge <left|right|up|down> [step] - expand the active window's edge in a direction
# Mirrors Omarchy's SUPER+[/] resize behavior. Multi-monitor aware.
set -e

if [ -z "$1" ]; then
  echo "Usage: $0 <left|right|up|down> [step]" >&2
  exit 1
fi

DIR="$1"
STEP="${2:-50}"

WIN=$(xdotool getactivewindow 2>/dev/null) || exit 0
[ -z "$WIN" ] && exit 0
eval "$(xdotool getwindowgeometry --shell "$WIN" | grep -E '^(X|Y|WIDTH|HEIGHT)=')"

# Clamp width/height so they don't go negative or exceed monitor
WCX=$((X + WIDTH / 2))
WCY=$((Y + HEIGHT / 2))
SW=1920; SH=1080; MX=0; MY=0
while read -r MON_INFO; do
  [ -z "$MON_INFO" ] && continue
  eval "$(echo "$MON_INFO" | awk -F'[x+/]' '{printf "MSW=%s MSH=%s MMX=%s MMY=%s", $1, $3, $5, $6}')"
  if [ "$WCX" -ge "$MMX" ] && [ "$WCX" -lt "$((MMX + MSW))" ] && [ "$WCY" -ge "$MMY" ] && [ "$WCY" -lt "$((MMY + MSH))" ]; then
    SW=$MSW; SH=$MSH; MX=$MMX; MY=$MMY
    break
  fi
done < <(xrandr --listactivemonitors | awk 'NR>1 {print $3}')

case "$DIR" in
  left)
    NEW_X=$((X - STEP))
    [ "$NEW_X" -lt "$MX" ] && NEW_X=$MX
    NEW_W=$((WIDTH + (X - NEW_X)))
    wmctrl -r :ACTIVE: -b remove,maximized_vert,maximized_horz >/dev/null
    wmctrl -r :ACTIVE: -e 0,"$NEW_X","$Y","$NEW_W","$HEIGHT" >/dev/null
    ;;
  right)
    NEW_W=$((WIDTH + STEP))
    MAX_W=$((MX + SW - X))
    [ "$NEW_W" -gt "$MAX_W" ] && NEW_W=$MAX_W
    [ "$NEW_W" -lt 50 ] && exit 0
    wmctrl -r :ACTIVE: -b remove,maximized_vert,maximized_horz >/dev/null
    wmctrl -r :ACTIVE: -e 0,"$X","$Y","$NEW_W","$HEIGHT" >/dev/null
    ;;
  up)
    NEW_Y=$((Y - STEP))
    [ "$NEW_Y" -lt "$MY" ] && NEW_Y=$MY
    NEW_H=$((HEIGHT + (Y - NEW_Y)))
    wmctrl -r :ACTIVE: -b remove,maximized_vert,maximized_horz >/dev/null
    wmctrl -r :ACTIVE: -e 0,"$X","$NEW_Y","$WIDTH","$NEW_H" >/dev/null
    ;;
  down)
    NEW_H=$((HEIGHT + STEP))
    MAX_H=$((MY + SH - Y))
    [ "$NEW_H" -gt "$MAX_H" ] && NEW_H=$MAX_H
    [ "$NEW_H" -lt 50 ] && exit 0
    wmctrl -r :ACTIVE: -b remove,maximized_vert,maximized_horz >/dev/null
    wmctrl -r :ACTIVE: -e 0,"$X","$Y","$WIDTH","$NEW_H" >/dev/null
    ;;
  *) echo "Invalid: $1 (left|right|up|down)" >&2; exit 1;;
esac
